{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAMEO AI",
  "version": "0.1.0",
  "identifier": "com.admin.cameo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CAMEO AI — Cognitive Autonomous Machine Executive Operator",
        "width": 520,
        "height": 76,
        "minWidth": 360,
        "minHeight": 68,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": "#0B1020"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
